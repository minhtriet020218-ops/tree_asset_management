PORT=8080
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tree_asset_management
DB_USER=postgres
DB_PASSWORD=change_me

# Active Directory (tài khoản chỉ cần quyền ĐỌC)
AD_URL=ldap://dc.yourcompany.local
AD_BASE_DN=DC=yourcompany,DC=local
AD_SERVICE_USER=svc_assetmgmt@yourcompany.local
AD_SERVICE_PASSWORD=change_me
# node_id (bảng tree_nodes) để gán cho máy mới tìm thấy từ AD, ví dụ node "Chưa phân loại".
# Bỏ trống thì node_id = NULL và máy sẽ không hiện dưới tầng nào của cây.
AD_DEFAULT_NODE_ID=
# Chạy đồng bộ AD ngay khi server khởi động
AD_SYNC_ON_START=true

# Lịch chạy (cú pháp cron)
SYNC_AD_CRON=0 2 * * *
STATUS_CRON=*/5 * * * *

# Kiểm tra online/offline
PROBE_PORTS=445,135,3389,9100,80,443
PROBE_TIMEOUT_MS=2000
PROBE_CONCURRENCY=100
# Số lần liên tiếp không phản hồi trước khi đánh dấu offline
OFFLINE_AFTER_FAILS=2
# Hậu tố DNS nếu hostname trong DB là tên ngắn và server không join domain, ví dụ: yourcompany.local
HOST_DNS_SUFFIX=
# Số lượt tra DNS song song (giữ nhỏ, tối đa 3) và thời gian chờ mỗi lượt
DNS_CONCURRENCY=3
DNS_TIMEOUT_MS=3000
